//ANSI color helpers.

/// ANSI CSI seq `ESC [`
#define ANSI_CSI "\x1b\x5B"

/// Generate an ANSI SGR escape code dynamically.
#define ANSI_SGR(ID) "[ANSI_CSI][ID]m"
/// Internal only, Variant of `ANSI_SGR` that can const fold and stringifies literally.
#define _ANSI_SGR_CONSTFOLD(ID) (ANSI_CSI + #ID + "m")

#define ANSI_FULL_RESET _ANSI_SGR_CONSTFOLD(0)

// Text styles

#define ANSI_BOLD _ANSI_SGR_CONSTFOLD(1)
#define ANSI_DIM _ANSI_SGR_CONSTFOLD(2)
#define ANSI_ITALIC _ANSI_SGR_CONSTFOLD(3)
#define ANSI_UNDERLINE _ANSI_SGR_CONSTFOLD(4)
#define ANSI_BLINK _ANSI_SGR_CONSTFOLD(5)
#define ANSI_REVERSE _ANSI_SGR_CONSTFOLD(7)
#define ANSI_HIDDEN _ANSI_SGR_CONSTFOLD(8)
#define ANSI_STRIKETHROUGH _ANSI_SGR_CONSTFOLD(9)

#define ANSI_UNBOLD _ANSI_SGR_CONSTFOLD(22)
#define ANSI_UNDIM _ANSI_SGR_CONSTFOLD(22)
#define ANSI_UNITALIC _ANSI_SGR_CONSTFOLD(23)
#define ANSI_UNUNDERLINE _ANSI_SGR_CONSTFOLD(24)
#define ANSI_UNBLINK _ANSI_SGR_CONSTFOLD(25)
#define ANSI_UNREVERSE _ANSI_SGR_CONSTFOLD(27)
#define ANSI_UNHIDDEN _ANSI_SGR_CONSTFOLD(28)
#define ANSI_UNSTRIKETHROUGH _ANSI_SGR_CONSTFOLD(29)

// Foreground (text) colors

#define ANSI_FG_BLACK _ANSI_SGR_CONSTFOLD(30)
#define ANSI_FG_RED _ANSI_SGR_CONSTFOLD(31)
#define ANSI_FG_GREEN _ANSI_SGR_CONSTFOLD(32)
#define ANSI_FG_YELLOW _ANSI_SGR_CONSTFOLD(33)
#define ANSI_FG_BLUE _ANSI_SGR_CONSTFOLD(34)
#define ANSI_FG_MAGENTA _ANSI_SGR_CONSTFOLD(35)
#define ANSI_FG_CYAN _ANSI_SGR_CONSTFOLD(36)
#define ANSI_FG_WHITE _ANSI_SGR_CONSTFOLD(37)

#define ANSI_FG_BRIGHT_RED _ANSI_SGR_CONSTFOLD(91)
#define ANSI_FG_BRIGHT_GREEN _ANSI_SGR_CONSTFOLD(92)
#define ANSI_FG_BRIGHT_YELLOW _ANSI_SGR_CONSTFOLD(93)
#define ANSI_FG_BRIGHT_BLUE _ANSI_SGR_CONSTFOLD(94)
#define ANSI_FG_BRIGHT_MAGENTA _ANSI_SGR_CONSTFOLD(95)
#define ANSI_FG_BRIGHT_CYAN _ANSI_SGR_CONSTFOLD(96)
#define ANSI_FG_BRIGHT_WHITE _ANSI_SGR_CONSTFOLD(97)

#define ANSI_FG_RESET _ANSI_SGR_CONSTFOLD(39)

// Background colors

#define ANSI_BG_BLACK _ANSI_SGR_CONSTFOLD(40)
#define ANSI_BG_RED _ANSI_SGR_CONSTFOLD(41)
#define ANSI_BG_GREEN _ANSI_SGR_CONSTFOLD(42)
#define ANSI_BG_YELLOW _ANSI_SGR_CONSTFOLD(43)
#define ANSI_BG_BLUE _ANSI_SGR_CONSTFOLD(44)
#define ANSI_BG_MAGENTA _ANSI_SGR_CONSTFOLD(45)
#define ANSI_BG_CYAN _ANSI_SGR_CONSTFOLD(46)
#define ANSI_BG_WHITE _ANSI_SGR_CONSTFOLD(47)

#define ANSI_BG_BRIGHT_RED _ANSI_SGR_CONSTFOLD(101)
#define ANSI_BG_BRIGHT_GREEN _ANSI_SGR_CONSTFOLD(102)
#define ANSI_BG_BRIGHT_YELLOW _ANSI_SGR_CONSTFOLD(103)
#define ANSI_BG_BRIGHT_BLUE _ANSI_SGR_CONSTFOLD(104)
#define ANSI_BG_BRIGHT_MAGENTA _ANSI_SGR_CONSTFOLD(105)
#define ANSI_BG_BRIGHT_CYAN _ANSI_SGR_CONSTFOLD(106)
#define ANSI_BG_BRIGHT_WHITE _ANSI_SGR_CONSTFOLD(107)

#define ANSI_BG_RESET _ANSI_SGR_CONSTFOLD(49)

// ANSI wrapper helpers.

#define ANSI_WRAP_BOLD(text) (ANSI_BOLD+text+ANSI_UNBOLD)
#define ANSI_WRAP_DIM(text) (ANSI_DIM+text+ANSI_UNDIM)
#define ANSI_WRAP_ITALIC(text) (ANSI_ITALIC+text+ANSI_UNITALIC)
#define ANSI_WRAP_UNDERLINE(text) (ANSI_UNDERLINE+text+ANSI_UNUNDERLINE)
#define ANSI_WRAP_BLINK(text) (ANSI_BLINK+text+ANSI_UNBLINK)
#define ANSI_WRAP_REVERSE(text) (ANSI_REVERSE+text+ANSI_UNREVERSE)
#define ANSI_WRAP_HIDDEN(text) (ANSI_HIDDEN+text+ANSI_UNHIDDEN)
#define ANSI_WRAP_STRIKETHROUGH(text) (ANSI_STRIKETHROUGH+text+ANSI_UNSTRIKETHROUGH)

/// Wrap text in a foreground color, resetting FG afterwards.
#define ANSI_WRAP_FG(FG, text) (FG+text+ANSI_FG_RESET)
/// Wrap text in a background color, resetting BG afterwards.
#define ANSI_WRAP_BG(BG, text) (BG+text+ANSI_BG_RESET)
/// Wrap text in both FG and BG, resetting both afterwards.
#define ANSI_WRAP_FG_BG(FG, BG, text) (FG+BG+text+ANSI_FG_RESET+ANSI_BG_RESET)
